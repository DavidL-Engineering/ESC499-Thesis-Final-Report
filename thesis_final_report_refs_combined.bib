	url = {https://arc.aiaa.org/doi/10.2514/1.C036968},
	doi = {10.2514/1.C036968},
	abstract = {Designing transonic laminar swept wing at high Reynolds numbers is challenging due to the premature flow transition from the prominent crossflow instabilities (CFIs). Hence, natural laminar flow (NLF) wings are limited to lower sweep angles. In this study, hybrid laminar flow control (HLFC) is used to extend this limit to design low-drag transonic infinite wing. A multi-objective genetic algorithm with competing drag components as objectives is used to design NLF and HLFC airfoils. Optimal design is a tradeoff between the drag reduction from skin friction drag, pressure drag, and suction drag, and does not resemble initial airfoils. Airfoil shape and suction distribution are coupled and optimized simultaneously. Euler flow solver with integral boundary-layer method is coupled with a higher-fidelity Linear Stability Analysis using 2.5D approximation for transition prediction. At wing sweep of 22.5°, Mach number of 0.78, and Reynolds number of 30 million, optimum NLF airfoil has 27\% lower drag than an optimum turbulent airfoil. The optimum HLFC airfoil showed a 25\% lower total drag than the NLF airfoil. A higher optimum sweep angle was observed for low-drag HLFC airfoil (20.5°) in comparison to the NLF airfoil (16.8°) and both favored an undercut on the lower surface to dampen CFI.},
	number = {3},
	urldate = {2024-01-18},
	journal = {Journal of Aircraft},
	author = {Sudhi, Anand and Radespiel, Rolf and Badrya, Camli},
	month = may,
	year = {2023},
	pages = {716--732},
	file = {Sudhi et al (2023) Design Exploration of Transonic Airfoils for Natural and Hybrid Laminar Flow Control Applications.pdf:C\:\\Users\\David\\OneDrive\\Zotero\\ESC499 - Thesis\\Thesis Interim Report Research\\Sudhi et al (2023) Design Exploration of Transonic Airfoils for Natural and Hybrid Laminar Flow Control Applications2.pdf:application/pdf},
}

@book{raymer_aircraft_2018,
